{
  "name": "dsh-focus-brief",
  "version": "0.3.0",
  "description": "把 agent 每轮的回答压成一张结果卡：一句结论 + 默认收起的信息块（需要你确认 / 关键数据 / 产出文件 / 结论建议 / 风险提醒）。块的骨架写死在本地，内容由模型按同一份回答格式契约填，不额外调用模型。",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shunshoudesi/dsh-focus-brief.git"
  },
  "homepage": "https://github.com/shunshoudesi/dsh-focus-brief#readme",
  "bugs": {
    "url": "https://github.com/shunshoudesi/dsh-focus-brief/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "focus-view",
    "chat-ui",
    "agent-answer"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "MANUAL.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "meta": {
    "title": "专注视图 Focus View",
    "description": "注册一个平行会话视图「专注」：切过去后官方那套一行行的渲染不再出现，整页是每轮一张结果卡——状态与标题、照官方气泡做的提问气泡（蓝底黑字、原样显示）、卡里的回答区（一句结论，点开换全文）、可展开的信息块（需要你确认 / 关键数据 / 产出文件 / 结论建议 / 风险提醒）。块的骨架写死在本地、内容由模型按同一条回答格式契约填（不额外调用模型）；产出文件与状态来自真实会话事件。卡片上不带执行日志（工具调用时间线仍在官方「轨迹」视图里）。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0",
      "node": ">=20.18",
      "profiles": [
        "web",
        "desktop"
      ],
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  }
}